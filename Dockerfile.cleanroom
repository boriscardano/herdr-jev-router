FROM rust@sha256:cf9fb3b5e1d2d5aa4e1452e306153774973de490a5d662819b5ee00cc286cb17

ARG TARGETARCH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        git \
        python3 \
        python3-venv \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_VERSION=0.12.17 UV_INSTALL_DIR=/usr/local/bin sh \
    && case "$TARGETARCH" in \
        arm64) zig_arch=aarch64 ;; \
        amd64) zig_arch=x86_64 ;; \
        *) printf 'unsupported Docker architecture: %s\n' "$TARGETARCH" >&2; exit 2 ;; \
       esac \
    && curl -LsSf \
        "https://ziglang.org/download/0.16.0/zig-${zig_arch}-linux-0.16.0.tar.xz" \
        | tar -xJ --strip-components=1 -C /usr/local \
    && ln -s /usr/local/zig /usr/local/bin/zig

WORKDIR /opt/herdr-jev-router
COPY . .
RUN uv sync --frozen --no-dev \
    && uv sync --frozen --group dev \
    && uv build

ENTRYPOINT ["/opt/herdr-jev-router/scripts/cleanroom-entrypoint.sh"]
